---
/**
 * Generic click-to-load iframe (Vimeo, Google Maps, Calendly...).
 * The iframe host must be enabled via `embeds` or `allow.frames` in astro-secure options,
 * otherwise the CSP blocks it.
 */
interface Props {
  src: string;
  title: string;
  /** Explains what loads and from whom (privacy). */
  notice: string;
  label?: string;
}
const { src, title, notice, label = 'Cargar contenido' } = Astro.props;
if (!src.startsWith('https://')) throw new Error('ClickToLoad src must be https.');
---
<div class="as-embed as-embed--generic" data-as-embed={src} data-as-title={title}>
  <div class="as-embed__placeholder">
    <p>{notice}</p>
    <button type="button" class="as-embed__button-generic">{label}</button>
  </div>
</div>

<style>
  .as-embed--generic { position: relative; aspect-ratio: 16 / 9; border: 1px solid currentColor; }
  .as-embed__placeholder { display: grid; place-content: center; gap: 1rem; height: 100%; padding: 1rem; text-align: center; }
  .as-embed__button-generic { justify-self: center; padding: 0.5rem 1rem; border: 1px solid currentColor; border-radius: 0.5rem; cursor: pointer; }
  .as-embed__button-generic:focus-visible { outline: 3px solid currentColor; outline-offset: 3px; }
  .as-embed--generic iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>

<script>
  import { activateEmbeds } from './embed-client.js';
  activateEmbeds();
</script>
